# ── Telegram credentials (https://my.telegram.org  +  @BotFather) ──────────
API_ID=123456
API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_TOKEN=123456:ABC-DEF...

# ── Access control ────────────────────────────────────────────────────────
# Users must send this code once to unlock the bot. First user becomes owner
# unless OWNER_ID is set (strongly recommended).
SECURITY_CODE=ChangeMe@2026
OWNER_ID=123456789

# ── Optional ──────────────────────────────────────────────────────────────
# Group/supergroup where every source + output file is backed up
BACKUP_GROUP_ID=-1001234567890
# Unicode TTF used for PDF output (Devanagari example below)
PDF_FONT_PATH=/usr/share/fonts/truetype/noto/NotoSansDevanagari-Regular.ttf
# Self-hosted LibreTranslate fallback endpoint
LIBRE_URL=https://libretranslate.com
# Where runtime data (inbox / outputs / db / cache / logs) lives
WORKDIR=workspace_textbot
